{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "rust",
    "include-component-in-tag": true,
    "bump-minor-pre-major": true,
    "bump-patch-for-minor-pre-major": true,
    "release-search-depth": 100,
    "commit-search-depth": 100,
    "commit-batch-size": 5,
    "plugins": [
        "cargo-workspace"
    ],
    "packages": {
        "crates/windows-file-enumeration-sys": {
            "package-name": "windows-file-enumeration-sys",
            "component": "windows-file-enumeration-sys"
        },
        "crates/windows-file-watcher": {
            "package-name": "windows-file-watcher",
            "component": "windows-file-watcher"
        },
        "crates/windows-file-watcher-example-test-harness": {
            "package-name": "windows-file-watcher-example-test-harness",
            "component": "windows-file-watcher-example-test-harness"
        },
        "crates/windows-impersonation-token-sys": {
            "package-name": "windows-impersonation-token-sys",
            "component": "windows-impersonation-token-sys"
        },
        "crates/windows-ioring-sys": {
            "package-name": "windows-ioring-sys",
            "component": "windows-ioring-sys"
        },
        "crates/windows-overlapped-io-sys": {
            "package-name": "windows-overlapped-io-sys",
            "component": "windows-overlapped-io-sys"
        },
        "crates/windows-namespace-request-sys": {
            "package-name": "windows-namespace-request-sys",
            "component": "windows-namespace-request-sys"
        },
        "crates/windows-thread-ambient-sys": {
            "package-name": "windows-thread-ambient-sys",
            "component": "windows-thread-ambient-sys"
        },
        "crates/windows-threadpool-sys": {
            "package-name": "windows-threadpool-sys",
            "component": "windows-threadpool-sys"
        },
        "crates/windows-topology-sys": {
            "package-name": "windows-topology-sys",
            "component": "windows-topology-sys"
        },
        "crates/wtf-string": {
            "package-name": "wtf-string",
            "component": "wtf-string"
        }
    }
}
