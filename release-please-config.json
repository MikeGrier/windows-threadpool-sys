{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "simple",
    "include-component-in-tag": true,
    "separate-pull-requests": true,
    "commit-search-depth": 100,
    "packages": {
        "crates/windows-file-watcher": {
            "package-name": "windows-file-watcher",
            "component": "windows-file-watcher",
            "extra-files": [
                "Cargo.toml"
            ]
        },
        "crates/windows-ioring-sys": {
            "package-name": "windows-ioring-sys",
            "component": "windows-ioring-sys",
            "extra-files": [
                "Cargo.toml"
            ]
        },
        "crates/windows-overlapped-io-sys": {
            "package-name": "windows-overlapped-io-sys",
            "component": "windows-overlapped-io-sys",
            "extra-files": [
                "Cargo.toml",
                {
                    "type": "toml",
                    "path": "../windows-threadpool-sys/Cargo.toml",
                    "jsonpath": "$.dependencies['windows-overlapped-io-sys'].version"
                },
                {
                    "type": "toml",
                    "path": "../windows-file-watcher/Cargo.toml",
                    "jsonpath": "$.dependencies['windows-overlapped-io-sys'].version"
                }
            ]
        },
        "crates/windows-threadpool-sys": {
            "package-name": "windows-threadpool-sys",
            "component": "windows-threadpool-sys",
            "extra-files": [
                "Cargo.toml",
                {
                    "type": "toml",
                    "path": "../windows-ioring-sys/Cargo.toml",
                    "jsonpath": "$.dependencies['windows-threadpool-sys'].version"
                },
                {
                    "type": "toml",
                    "path": "../windows-file-watcher/Cargo.toml",
                    "jsonpath": "$.dependencies['windows-threadpool-sys'].version"
                }
            ]
        },
        "crates/windows-topology-sys": {
            "package-name": "windows-topology-sys",
            "component": "windows-topology-sys",
            "extra-files": [
                "Cargo.toml",
                {
                    "type": "toml",
                    "path": "../windows-ioring-sys/Cargo.toml",
                    "jsonpath": "$['dev-dependencies']['windows-topology-sys'].version"
                }
            ]
        },
        "crates/wtf-string": {
            "package-name": "wtf-string",
            "component": "wtf-string",
            "extra-files": [
                "Cargo.toml",
                {
                    "type": "toml",
                    "path": "../windows-file-watcher/Cargo.toml",
                    "jsonpath": "$.dependencies['wtf-string'].version"
                }
            ]
        }
    }
}
