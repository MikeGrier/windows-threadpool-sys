          ["reserving(16/48)", 1, 50.0, 20000000.0, 0, 40.0, 6000.0],
          ["reserving(16/48)", 2, 3000.0, 666666.0, 0, 40.0, 90000.0],
          ["reserving(8/56)", 1, 60.0, 16666666.0, 0, 40.0, 7000.0],
          ["reserving(8/56)", 2, 3200.0, 625000.0, 0, 40.0, 95000.0]
        ],
        "drained": [
          ["slotwise_mpsc", 1, 11.0, 90909090.0, 0, 4.0, 6.0],
          ["slotwise_mpsc", 2, 30.0, 66666666.0, 1200, 4.0, 60.0],
          ["reserving_mpsc", 1, 26.0, 38461538.0, 0, 4.0, 60.0],
          ["reserving_mpsc", 2, 3000.0, 666666.0, 1100, 40.0, 90000.0],
          ["permit_mpsc", 1, 64.0, 15625000.0, 0, 4.0, 60.0],
          ["permit_mpsc", 2, 3000.0, 666666.0, 900, 40.0, 90000.0],
