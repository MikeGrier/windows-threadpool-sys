        "available_parallelism": 8,
        "isolated": [
          ["baseline_fetch_add", 1, 2.3, 434782608.0, 0, 2.1, 2.5],
          ["baseline_fetch_add", 2, 12.1, 165289256.0, 0, 11.0, 13.0],
